<odoo>
    <data>
      <record id="person_tree_view" model="ir.ui.view">
          <field name="name">person.tree.view</field>
          <field name="model">debtor.person</field>
          <field name="arch" type="xml">
              <list>
                  <field name="name"/>
                  <field name="phone"/>
              </list>
          </field>
      </record>

      <record id="person_form_view" model="ir.ui.view">
          <field name="name">person.form.view</field>
          <field name="model">debtor.person</field>
          <field name="arch" type="xml">
              <form>
                <group>
                  <field name="name"/>                  
                </group>
                <group>
                  <field name="phone"/>                
                </group>
                
              </form>
          </field>
      </record>

      <record id="person_action" model="ir.actions.act_window">
          <field name="name">Persons</field>
          <field name="res_model">debtor.person</field>
          <field name="view_mode">list,form</field>
      </record>

      <menuitem id="menu_root" name="Debtor"/>
      <menuitem id="menu_persons" name="Persons" parent="menu_root" />
      <menuitem id="menu_persons_list" name="Persons List" 
                parent="menu_persons" action="person_action" />

    </data>
</odoo>


