# =============================================================================
# Production only — copy to .env and adjust. Do not commit .env.
#
# Do not set ODOO_DEV (disables dev/qweb/reload features; compose forces it off).
# Avoid ODOO_LOG_LEVEL=debug in production.
# =============================================================================

# --- PostgreSQL (VM / remote host) ---
PGHOST=192.168.1.32
PGPORT=5432
PGUSER=postgres
POSTGRES_PASSWORD=YourStrongP@ss

# prefer | require | verify-full — use require when Postgres uses TLS on 5432
PGSSLMODE=prefer

# --- Odoo ---
ODOO_DATABASE=appdb

# Master password for database manager / neutralization (not a user login).
ODOO_ADMIN_PASSWD=ChangeThisToALongRandomSecret

# Prefork workers — typical rule: (2 × CPU cores) + 1; leave headroom for cron/gevent.
ODOO_WORKERS=4

# Logging: critical | error | warn | info | debug | notset
ODOO_LOG_LEVEL=info

ODOO_MAX_CRON_THREADS=1

# Request limits (seconds)
ODOO_LIMIT_TIME_CPU=120
ODOO_LIMIT_TIME_REAL=240

# Per-worker RSS limits in bytes (defaults: ~2 GiB soft / ~2.5 GiB hard)
ODOO_LIMIT_MEMORY_SOFT=2147483648
ODOO_LIMIT_MEMORY_HARD=2684354560

ODOO_HTTP_PORT=8069
ODOO_LONGPOLLING_PORT=8072

# Custom Odoo addons live under ./modules (mounted at /mnt/extra-addons); each module is modules/<name>/
